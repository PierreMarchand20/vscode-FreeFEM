{
    "author": "Pierre Marchand",
    "bugs": {
        "url": "https://github.com/PierreMarchand20/vscode-FreeFEM/issues/"
    },
    "name": "vscode-freefem",
    "displayName": "vscode-FreeFEM",
    "description": "FreeFEM language support in Visual Studio Code",
    "version": "2.2.3",
    "keywords": [
        "FreeFEM",
        "language"
    ],
    "engines": {
        "vscode": "^1.87.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "main": "./out/extension.js",
    "activationEvents": [
        "onDebugResolve:freefem"
    ],
    "contributes": {
        "markdown.markdownItPlugins": true,
        "languages": [
            {
                "id": "freefem",
                "aliases": [
                    "FreeFEM",
                    "freefem"
                ],
                "extensions": [
                    ".edp",
                    ".idp"
                ],
                "configuration": "./language-configuration.json"
            },
            {
                "id": "freefem-markdown-injection"
            }
        ],
        "grammars": [
            {
                "language": "freefem",
                "scopeName": "source.edp",
                "path": "./syntaxes/freefem.tmLanguage.json"
            },
            {
                "language": "freefem-markdown-injection",
                "scopeName": "markdown.freefem.codeblock",
                "path": "./syntaxes/freefem-markdown-injection.json",
                "injectTo": [
                    "text.html.markdown"
                ],
                "embeddedLanguages": {
                    "meta.embedded.block.freefem": "freefem"
                }
            }
        ],
        "commands": [
            {
                "title": "Run current FreeFEM file",
                "command": "freefem.runFile",
                "category": "FreeFEM",
                "icon": "$(run)",
                "when": "resourceLangId == freefem || editorLangId == markdown"
            },
            {
                "title": "Debug current FreeFEM file",
                "command": "freefem.debugFile",
                "category": "FreeFEM",
                "icon": "$(debug-alt)",
                "when": "resourceLangId == freefem"
            }
        ],
        "menus": {
            "editor/title/run": [
                {
                    "command": "freefem.runFile",
                    "group": "navigation@0",
                    "title": "Run current FreeFEM file",
                    "when": "resourceLangId == freefem || editorLangId == markdown"
                },
                {
                    "command": "freefem.debugFile",
                    "group": "navigation@1",
                    "title": "Debug current FreeFEM file",
                    "when": "resourceLangId == freefem"
                }
            ]
        },
        "keybindings": [
            {
                "key": "shift+cmd+r",
                "command": "freefem.runFile"
            }
        ],
        "configuration": {
            "title": "FreeFEM",
            "properties": {
                "freefem.executable": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "Interpreter used by the debugger. Empty = `FreeFem++` found on `PATH`. It must be a FreeFEM built with the debugger support (see the README)."
                },
                "freefem.ffglut": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "Plot viewer used by the debugger, passed as `-glut`. Empty = let FreeFem++ find its own."
                }
            }
        },
        "breakpoints": [
            {
                "language": "freefem"
            }
        ],
        "debuggers": [
            {
                "type": "freefem",
                "label": "FreeFEM",
                "languages": [
                    "freefem"
                ],
                "configurationAttributes": {
                    "launch": {
                        "required": [
                            "program"
                        ],
                        "properties": {
                            "program": {
                                "type": "string",
                                "description": "The .edp script to run.",
                                "default": "${file}"
                            },
                            "stopOnEntry": {
                                "type": "boolean",
                                "description": "Stop before the first statement.",
                                "default": false
                            },
                            "args": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                },
                                "description": "Extra interpreter arguments, e.g. [\"-v\",\"0\"].",
                                "default": []
                            },
                            "cwd": {
                                "type": "string",
                                "description": "Working directory (default: the script's folder)."
                            },
                            "executable": {
                                "type": "string",
                                "description": "Interpreter to run (default: the freefem.executable setting, else FreeFem++ on PATH)."
                            },
                            "ffglut": {
                                "type": "string",
                                "description": "Plot viewer passed as -glut (default: the freefem.ffglut setting)."
                            }
                        }
                    }
                },
                "initialConfigurations": [
                    {
                        "type": "freefem",
                        "request": "launch",
                        "name": "FreeFEM: debug current file",
                        "program": "${file}",
                        "stopOnEntry": false
                    }
                ],
                "configurationSnippets": [
                    {
                        "label": "FreeFEM: debug a script",
                        "description": "Debug an .edp file",
                        "body": {
                            "type": "freefem",
                            "request": "launch",
                            "name": "FreeFEM: debug ${1:script}",
                            "program": "^\"\\${file}\"",
                            "stopOnEntry": false
                        }
                    }
                ]
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile && npm run lint",
        "lint": "eslint src --ext ts",
        "test": "vscode-test",
        "test:debugger": "npm run compile && node test/debugger/extension-mock.test.js",
        "test:debugger:interpreter": "npm run compile && node test/debugger/adapter.test.js && python3 test/debugger/suite.py"
    },
    "dependencies": {
        "shiki": "^0.14"
    },
    "devDependencies": {
        "@types/vscode": "^1.87.0",
        "@types/mocha": "^10.0.6",
        "@types/node": "18.x",
        "@typescript-eslint/eslint-plugin": "^7.0.2",
        "@typescript-eslint/parser": "^7.0.2",
        "eslint": "^8.56.0",
        "typescript": "^5.3.3",
        "@vscode/test-cli": "^0.0.6",
        "@vscode/test-electron": "^2.3.9"
    },
    "icon": "logos/logo.png",
    "homepage": "https://freefem.org",
    "license": "MIT",
    "publisher": "Pierre-Marchand",
    "repository": {
        "type": "git",
        "url": "https://github.com/PierreMarchand20/vscode-FreeFEM.git"
    }
}
